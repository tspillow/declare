#!/bin/bash
set -e

# Welcome to katana.
# katana is the manager for katana's things, such as declarativity, etc.
# author: tspillow (License: GPL v2.0)
# ----------------------------------------------------------------------

CONFIG="/katana/declare/config.lua"
LIB_MAIN="/usr/lib/katana/main.lua"
STOCK_CONFIG="/usr/share/katana/config.lua"
BACKUP_CONFIG="/katana/declare/backups/katanaBackup.lua.bak"

help() {
	cat <<EOF
katanactl: Katana Linux command line tool

Usage: katanactl <command>

Commands:
  rebuild          applies the config's changes (add --dry-run to preview)
  reset-config     reset the config back to stock
  backup-config    backup the config in a specialized folder
  restore-backup   use the backup as your main config
  update           update the entire system, including AUR packages
  config           show the config's contents and more info
  version          show kat's current version
  help             show everything you're seeing right now
EOF
	exit "${1:-0}"
}

# show help if there are no arguments
if [ -z "$1" ]; then
	help 1
fi

# need sudo
if [ $EUID -ne 0 ]; then
	echo "No."
	exit 1
fi

# define what which argument does
case "$1" in
	rebuild)
		echo "Rebuilding..."
		lua "$LIB_MAIN" "${@:2}"
		;;
	reset-config)
		read -r -p "This will change your config back to the Katana stock config. Are you sure? [y/N] " response

		case "$response" in
			[yY][eE][sS]|[yY])
				sudo rm -rf "$CONFIG"
				sudo cp "$STOCK_CONFIG" "$CONFIG"
				sudo chown -R $USER:$USER /katana/declare/config.lua
				echo "[SUCCESS] Done."
				;;
			*)
				echo "Aborted."
				exit 1
				;;
		esac
		;;
	update)
		yay
		;;
	help)
		help 0
		;;
	version)
		echo "katanactl 0.1.0"
		;;
	backup-config)
		echo "Backing up..."
		sudo mkdir -p "$(dirname "$BACKUP_CONFIG")"
		sudo cp "$CONFIG" "$BACKUP_CONFIG"
		echo "[SUCCESS] Done."
		;;
	restore-backup)
		echo "Restoring..."
		sudo mv "$BACKUP_CONFIG" "$CONFIG"
		echo "[SUCCESS] Done."
		;;
	config)
		echo "/katana/declare/config.lua - Katana configuration file(..?)"
		echo "-- CONTENTS --"
		cat "$CONFIG"
		;;
	ihatekatana)
		echo ">:((("
		sleep 1
		echo "this is wat u get for hating on my katana :( grrr"
		sleep 1
		echo "echo c | sudo tee /proc/sysrq-trigger"
		sleep 0.3
 		echo c | sudo tee /proc/sysrq-trigger
		;;
	*)
		echo "I'd love to run $1 but idk what that is"
		help 1
		;;
esac
