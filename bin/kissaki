#!/bin/bash
set -e

# Welcome to kissaki.
# Kissaki is the declarative system for Katana Linux
# author: tspillow (License: GPL v2.0)
# ----------------------------------------------------------------------

LIB_DIR="/usr/lib/kissaki/"
CONFIG="/etc/kissaki/configuration.lua"
LIB_MAIN="/usr/lib/kissaki/main.lua"
STOCK_CONFIG="/usr/share/kissaki/config.lua"
BACKUP_CONFIG="/etc/kissaki/backups/configuration.lua.bak"

help() {
	cat <<EOF
kissaki - Katana Linux's declarative system

Usage: kissaki <command>

Commands:
  rebuild          applies the config's changes (add --dry-run to preview)
  reset-config     reset the config back to stock
  backup-config    backup the config in a specialized folder
  restore-backup   use the backup as your main config
  version          show kissaki's current version
  help             show everything you're seeing right now
EOF
	exit "${1:-0}"
}

# show help if there are no arguments
if [ -z "$1" ]; then
	help 1
fi

# need sudo
if [ $EUID -ne 0 ]; then
	quotes=(
	   "What's the magic word?"
	   "Ever heard of sudo?"
	   "No."
	   "Hey, $USER. Did you know you can use sudo?"
	   "Error: OPSEC = Activated, so you need to run this with root privileges!"
	   "Are you kidding me?"
	   "What do you think?"
	   "PARRY."
            "It's like letting a 5 year old play with fire."
	   "I'm afraid you don't know that things like this need permission"
	   "Good try."
	   "What is the type of person that uses kissaki $1 without sudo?"
	)
	rand_idx=$((RANDOM % ${#quotes[@]}))
        echo "${quotes[$rand_idx]}"
	exit 1
fi

# define what which argument does
case "$1" in
	rebuild)
		echo "Rebuilding..."
		lua "$LIB_MAIN" "${@:2}"
		;;
	reset-config)
		read -r -p "This will change your config back to the Katana stock config. Are you sure? [y/N] " response

		case "$response" in
			[yY][eE][sS]|[yY])
				sudo rm -rf "$CONFIG"
				sudo cp "$STOCK_CONFIG" "$CONFIG"
				echo "[SUCCESS] Done."
				;;
			*)
				echo "Aborted."
				exit 1
				;;
		esac
		;;
	update)
		yay
		;;
	help)
		help 0
		;;
	version)
		echo "kissaki 0.4.2"
		;;
	backup-config)
		echo "Backing up..."
		sudo mkdir -p "$(dirname "$BACKUP_CONFIG")"
		sudo cp "$CONFIG" "$BACKUP_CONFIG"
		echo "[SUCCESS] Done."
		;;
	restore-backup)
		echo "Restoring..."
		sudo rm -rf "$CONFIG"
		sudo mv "$BACKUP_CONFIG" "$CONFIG"
		echo "[SUCCESS] Done."
		;;
	config)
		echo "$CONFIG - Kissaki configuration file"
		echo "-- CONTENTS --"
		cat "$CONFIG"
		;;
	ihatekatana)
		echo ">:((("
		sleep 1
		echo "this is wat u get for hating on my katana :( grrr"
		sleep 1
		echo "echo c | sudo tee /proc/sysrq-trigger"
		sleep 0.3
 		echo c | sudo tee /proc/sysrq-trigger
		;;
	*)
		echo "$1? What's that? A dog whistle?"
		help 1
		;;
esac
